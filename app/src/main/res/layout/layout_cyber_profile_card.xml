<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cyberProfileCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:strokeWidth="2.5dp"
    app:strokeColor="#00FF66">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0B0E14"
        android:padding="18dp">

        <!-- Header Status with animation dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_status_indicator" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:text="تمت المطابقة // SHADOW_ID"
                android:textColor="#00FF66"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="تمت المطابقة // SHADOW_ID" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_confidence"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="99.2%"
                android:textColor="#0B0E14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#1E3A4A" />

        <!-- Profile Content - Beautiful & Organized -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="#00FF66"
                app:cardElevation="8dp">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="أحمد السعيد"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="أحمد السعيد" />

                <TextView
                    android:id="@+id/tvJobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="مهندس أمن سيبراني"
                    android:textColor="#00FF66"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="مهندس أمن سيبراني" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawableTint="#00FF66"
                        android:drawablePadding="5dp"
                        android:text="772123456"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvIdBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1A2A1A"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="ID: 001"
                        android:textColor="#00FF66"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Address with beautiful background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#121821"
                android:padding="12dp"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:drawableTint="#00F0FF"
                android:drawablePadding="8dp"
                android:text="صنعاء - اليمن - شارع الستين"
                android:textColor="#90A4AE"
                android:textSize="12sp"
                tools:text="صنعاء - اليمن" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Quality & Speed Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <TextView
                android:id="@+id/tvQualityInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#0F1A0F"
                android:padding="6dp"
                android:text="جودة: 95%"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSpeedInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#0F1A1A"
                android:padding="6dp"
                android:text="سرعة: 0.15s"
                android:textColor="#00F0FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center" />

        </LinearLayout>

        <!-- Unknown Alert Section - Red Theme -->
        <LinearLayout
            android:id="@+id/layoutUnknownAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#2A0A14"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ تنبيه: تم رصد شخص مجهول!"
                android:textColor="#FF0055"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvUnknownTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2026-09-30 14:30:15"
                android:textColor="#FF6B8A"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📸 تم التقاط 1 صورة تلقائياً // AUTO_CAPTURE"
                android:textColor="#FF8FA3"
                android:textSize="11sp"
                android:gravity="center"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="سيتم حفظه في تبويب المجهولين"
                android:textColor="#607D8B"
                android:textSize="10sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
