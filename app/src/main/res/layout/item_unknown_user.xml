<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FF0055">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1A0F14"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FF0055">

            <ImageView
                android:id="@+id/ivUnknownPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ شخص غير معرف"
                android:textColor="#FF0055"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUnknownDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2026-09-30 14:30:15"
                android:textColor="#FF8FA3"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvUnknownId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG_ID: 007"
                android:textColor="#FF0055"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:background="#2A1218"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تم الالتقاط تلقائياً // AUTO_CAPTURE"
                android:textColor="#607D8B"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteUnknown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مسح السجل"
            android:textSize="10sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="#FF0055"
            android:textColor="#FF0055"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconSize="14dp"
            app:iconTint="#FF0055" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
