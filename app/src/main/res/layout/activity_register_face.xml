<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Camera Preview Top Half -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewRegister"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent" />

    <com.shadowlook.app.ui.view.OverlayView
        android:id="@+id/overlayViewRegister"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC0B0E14"
        android:text="تسجيل وجه جديد // ENROLL_FACE"
        android:textColor="#00F0FF"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:padding="12dp"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Form Bottom Half -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0B0E14"
        app:layout_constraintTop_toBottomOf="@id/previewViewRegister"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="معلومات الشخص"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00F0FF"
                app:hintTextColor="#00F0FF"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="الاسم الكامل"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#607D8B"
                    android:inputType="textPersonName" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00F0FF"
                app:hintTextColor="#00F0FF"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="رقم الهاتف"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#607D8B"
                    android:inputType="phone" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Job Title -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00F0FF"
                app:hintTextColor="#00F0FF"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="المسمى الوظيفي"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#607D8B"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00F0FF"
                app:hintTextColor="#00F0FF"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="عنوان السكن"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#607D8B"
                    android:inputType="textPostalAddress" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Capture Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureEnroll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="تسجيل البيانات // CAPTURE &amp; ENROLL"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_camera"
                app:cornerRadius="12dp"
                android:backgroundTint="#00F0FF"
                android:textColor="#0B0E14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سيتم التقاط الوجه الحالي وحفظه مع البيانات المدخلة في قاعدة البيانات المشفرة"
                android:textColor="#607D8B"
                android:textSize="11sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
