<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FF0055">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A0F14">

        <ImageView
            android:id="@+id/ivUnknownSimilar"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSimilarityPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="87.3%"
                android:textColor="#FF0055"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvUnknownDateSimilar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2026-09-30"
                android:textColor="#FF8FA3"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
