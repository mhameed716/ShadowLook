<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0B0E14">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تحويل مجهول إلى معروف // CONVERT_TO_KNOWN"
        android:textColor="#00FF66"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        app:cardCornerRadius="50dp"
        app:strokeWidth="2dp"
        app:strokeColor="#00FF66"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivUnknownToConvert"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvUnknownOriginalDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تاريخ الالتقاط: 2026-09-30 14:30:15"
        android:textColor="#FF8FA3"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#00FF66"
        app:hintTextColor="#00FF66"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConvertName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الاسم الكامل *"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B"
            android:inputType="textPersonName" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#00FF66"
        app:hintTextColor="#00FF66"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConvertPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رقم الهاتف"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B"
            android:inputType="phone" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#00FF66"
        app:hintTextColor="#00FF66"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConvertJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="المسمى الوظيفي"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#00FF66"
        app:hintTextColor="#00FF66"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConvertAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان السكن"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B"
            android:inputType="textPostalAddress" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سيتم إضافة التاريخ تلقائياً لكل صورة"
        android:textColor="#607D8B"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

</LinearLayout>
